# Application
APP_ENV=development
APP_NAME=gdrive-organizer
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://kip:kip@localhost:5432/kip

# Redis / queues
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google OAuth (Drive read-only for Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/drive.readonly

# OpenAI (embeddings — optional until pipeline is wired)
OPENAI_API_KEY=

# Feature flags
ENABLE_CHAT_ENDPOINT=false
